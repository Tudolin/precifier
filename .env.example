# =====================================================================
# Copie este arquivo para ".env.local" e preencha os valores.
# Na Vercel, cadastre as mesmas variaveis em Settings > Environment Variables.
# =====================================================================

# --- Banco de dados (Vercel KV / Redis) ------------------------------
# Crie em: Vercel > Storage > Create Database > KV.
# Ao conectar o banco ao projeto, a Vercel preenche estas duas sozinha.
# Se ficarem vazias, o sistema usa um arquivo local (.precifier-local.json)
# apenas para desenvolvimento na sua maquina.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Seguranca do login (NextAuth) -----------------------------------
# Gere uma chave aleatoria: openssl rand -base64 32
NEXTAUTH_SECRET=troque-por-uma-chave-aleatoria-bem-longa
# Em producao use a URL real, ex.: https://precifier.vercel.app
NEXTAUTH_URL=http://localhost:3000

# --- Usuario unico (o dono da casa de massas) ------------------------
# Na primeira vez que alguem tentar entrar, o sistema cria este usuario
# automaticamente no banco (seed), guardando a senha com hash bcrypt.
USER_EMAIL=dono@minhamassa.com.br

# Opcao A (mais simples): senha em texto puro. O sistema gera o hash sozinho.
USER_PASSWORD=trocar-esta-senha

# Opcao B (mais segura): coloque o hash bcrypt e apague o USER_PASSWORD acima.
# Gere o hash com: npm run hash "minha-senha"
# USER_PASSWORD_HASH=$2a$10$......
